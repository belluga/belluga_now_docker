{
  "schema_version": "ci-contract-v1",
  "contract_id": "root-invariants",
  "description": "Mandatory root invariants that every local CI-equivalent contract must preserve.",
  "entries": [
    {
      "id": "root-invariant-guard",
      "repo": "belluga_now_docker",
      "kind": "mandatory-root-invariant",
      "cwd": "../../..",
      "command": [
        "bash",
        "-lc",
        "VERIFY_ENV_EVENT_NAME=\"${VERIFY_ENV_EVENT_NAME:-pull_request}\" VERIFY_ENV_BASE_REF=\"${VERIFY_ENV_BASE_REF:-dev}\" bash .github/scripts/verify_environment_ci.sh"
      ],
      "description": "Fail closed when root workflow/runtime/parity invariants drift."
    },
    {
      "id": "contact-channels-fixture-equality",
      "repo": "belluga_now_docker",
      "kind": "mandatory-root-invariant",
      "cwd": "../../..",
      "command": [
        "python3",
        "tools/contact_channels/verify_fixture_equality.py"
      ],
      "description": "Fail closed when either implementation fixture drifts from the canonical contact-channel corpus."
    },
    {
      "id": "canonical-contact-source-picker-contract",
      "repo": "belluga_now_docker",
      "kind": "mandatory-root-invariant",
      "cwd": "../../..",
      "command": [
        "python3",
        "tools/contact_channels/verify_canonical_contact_source_picker_contract.py"
      ],
      "description": "Fail closed when the contact-source picker drifts away from the canonical generic Account Profile index with server-owned eligibility filters and preview payload."
    }
  ]
}
