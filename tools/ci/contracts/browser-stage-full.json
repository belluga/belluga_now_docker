    {
      "id": "local-public-warmup",
      "repo": "belluga_now_docker",
      "kind": "workflow-parity",
      "cwd": "../../..",
      "command": ["bash", "tools/ci/run_stage_browser_contract.sh", "local-public", "warmup"],
