{
  "schema_version": "ci-contract-v1",
  "contract_id": "browser-stage-full",
  "description": "Local-public browser/runtime contract that mirrors the explicit stage pipeline browser sequence through the same leaf scripts and step order.",
  "entries": [
    {
      "id": "local-public-web-build",
      "repo": "belluga_now_docker",
      "kind": "workflow-parity",
      "cwd": "../../..",
      "command": ["bash", "tools/ci/run_stage_browser_contract.sh", "local-public", "build"],
      "description": "Build the local-public web surface through the shared leaf runner before browser parity validation."
    },
    {
