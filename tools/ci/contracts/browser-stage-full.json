      "repo": "belluga_now_docker",
      "kind": "workflow-parity",
      "cwd": "../../..",
      "command": ["bash", "tools/ci/run_stage_browser_contract.sh", "local-public", "host-overrides-reset"],
      "description": "Reset managed navigation host overrides before the public-edge probe, mirroring the stage workflow precondition."
    },
    {
      "id": "local-public-public-edge-probe",
      "repo": "belluga_now_docker",
      "kind": "workflow-parity",
      "cwd": "../../..",
      "command": ["bash", "tools/ci/run_stage_browser_contract.sh", "local-public", "probe-public-edge"],
      "description": "Probe the public local-public environment through the same public-edge script the stage workflow uses."
    },
    {
