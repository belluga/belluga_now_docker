# Local web navigation smoke defaults.
# Copy to .env.local.navigation or run tools/flutter/setup_local_navigation_env.sh.
# .env.local.navigation is gitignored and may contain local-only credentials.

# Fill these explicitly for your local target. Do not keep shared/public domains as defaults.
# NAV_LANDLORD_URL=http://localhost
# NAV_TENANT_URL=http://localhost
NAV_DEPLOY_LANE=local
PLAYWRIGHT_IGNORE_HTTPS_ERRORS=true

# Diagnostic suite still requires NAV_DEPLOY_LANE and NAV_RUNTIME_DB_MUTATION_ALLOWED in the shell environment.
# Required for mutation and diagnostic navigation smoke.
# Keep these values only in .env.local.navigation or in your shell environment.
# NAV_ADMIN_EMAIL=
# NAV_ADMIN_PASSWORD=
# NAV_RUNTIME_DB_MUTATION_ALLOWED=1
